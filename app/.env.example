# Chép tệp này thành `.env` rồi điền khoá thật. `.env` đã được git bỏ qua.
#
#   cp app/.env.example app/.env
#
# Khoá API của Anthropic — bật đọc ảnh hoá đơn tự động và trả lời dự phòng cho
# Ekko bot. Không có khoá thì hai tính năng đó tự tắt, phần còn lại chạy bình thường.
ANTHROPIC_API_KEY=

# Model dùng cho hai việc trên. Để trống là dùng mặc định claude-opus-5.
ANTHROPIC_MODEL=
